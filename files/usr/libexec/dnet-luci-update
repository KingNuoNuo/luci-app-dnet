#!/bin/sh
set -eu
program=$1
mode=$2
run=/var/run/dnet-luci
mkdir -p "$run"
mkdir "$run/lockdir" 2>/dev/null || exit 3
trap 'rmdir "$run/lockdir" 2>/dev/null || true' EXIT
printf '%s\n' running >"$run/status"
printf '%s\n' "$mode" >"$run/mode"
printf '%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" >"$run/started"
cd "$(dirname "$program")"
rc=0
if [ "$mode" = update ]; then
	# 升级走 LuCI 自己的校验下载链路（SHA-256 + 重启），不依赖 dnet -u 的自检：
	# 旧程序的版本号不是语义化版本（日期构建号、DEV 等）时，dnet -u 会拒绝自检，
	# 而 bootstrap 只看发布资产，对任何已安装版本都能完成升级。
	config=$(/sbin/uci -q get dnet.main.config_path || true)
	[ -n "$config" ] || config=/mnt/sda1/.dnet_config.yaml
	/usr/libexec/dnet-luci-bootstrap "$program" "$config" >>"$run/output" 2>&1 || rc=$?
else
	printf 'n\n' | "$program" -u >"$run/output" 2>&1 || rc=$?
fi
printf '%s\n' "$rc" >"$run/exit_code"
printf '%s\n' done >"$run/status"
exit 0
