# Router-side files must keep LF endings: CRLF breaks sh scripts and ucode.
* text=auto eol=lf

# Everything below is installed verbatim onto the router.
root/**             text eol=lf
htdocs/**           text eol=lf
*.sh                text eol=lf
*.js                text eol=lf
Makefile            text eol=lf

# Package binaries
*.ipk               binary
